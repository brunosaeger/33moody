{
  "name": "33moody",
  "private": true,
  "description": "Plataforma web de diagnóstico robótico com replay técnico-visual",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @moody/web",
    "build": "npm run build -w @moody/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint apps packages"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
